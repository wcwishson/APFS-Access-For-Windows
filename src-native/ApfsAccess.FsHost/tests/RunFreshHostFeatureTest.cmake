if(NOT DEFINED TEST_EXE OR NOT EXISTS "${TEST_EXE}" OR NOT DEFINED EVIDENCE_ROOT)
    message(FATAL_ERROR "Host feature executable and evidence root are required")
endif()
string(TIMESTAMP run_time "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" run_id)
set(run_root "${EVIDENCE_ROOT}/run-${run_time}-${run_id}")
if(EXISTS "${run_root}")
    message(FATAL_ERROR "Refusing populated host feature evidence directory")
endif()
file(MAKE_DIRECTORY "${run_root}")
execute_process(COMMAND "${TEST_EXE}" WORKING_DIRECTORY "${run_root}"
    RESULT_VARIABLE test_result OUTPUT_VARIABLE test_output ERROR_VARIABLE test_error TIMEOUT 240)
file(WRITE "${run_root}/stdout.log" "${test_output}")
file(WRITE "${run_root}/stderr.log" "${test_error}")
message("${test_output}${test_error}")
if(NOT test_result STREQUAL "0")
    message(FATAL_ERROR "Host feature test failed: ${test_result}; evidence: ${run_root}")
endif()
