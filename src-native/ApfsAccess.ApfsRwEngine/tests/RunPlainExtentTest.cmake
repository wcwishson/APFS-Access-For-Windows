if(NOT DEFINED TEST_EXE OR NOT EXISTS "${TEST_EXE}" OR
   NOT DEFINED EVIDENCE_ROOT OR NOT IS_ABSOLUTE "${EVIDENCE_ROOT}")
    message(FATAL_ERROR "Plain extent executable and absolute private evidence root required")
endif()
if(NOT MODE STREQUAL "Layout" AND NOT MODE STREQUAL "Replay")
    message(FATAL_ERROR "MODE must be Layout or Replay")
endif()
if(DEFINED OLD_TEST_EXE AND NOT EXISTS "${OLD_TEST_EXE}")
    message(FATAL_ERROR "Optional original-engine test executable is missing")
endif()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" nonce)
set(root "${EVIDENCE_ROOT}/${MODE}-${stamp}-${nonce}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refusing existing plain extent suite directory")
endif()
file(MAKE_DIRECTORY "${root}")
file(SHA256 "${TEST_EXE}" test_hash)
file(WRITE "${root}/inputs.txt" "candidate=${TEST_EXE}\nsha256=${test_hash}\n")
if(DEFINED OLD_TEST_EXE)
    file(SHA256 "${OLD_TEST_EXE}" old_hash)
    file(APPEND "${root}/inputs.txt" "original=${OLD_TEST_EXE}\nsha256=${old_hash}\n")
endif()
message(STATUS "Owned plain extent suite: ${root}")
function(run_phase executable case_name phase)
    set(work "${root}/${case_name}")
    file(MAKE_DIRECTORY "${work}")
    execute_process(COMMAND "${executable}" ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${work}/${phase}.log" "${output}${error}\nexit=${result}\n")
    message("${output}${error}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Plain extent ${case_name}/${phase} failed: ${result}; ${root}")
    endif()
endfunction()
if(MODE STREQUAL "Layout")
    run_phase("${TEST_EXE}" layout layout)
else()
    run_phase("${TEST_EXE}" new-published produce produce)
    run_phase("${TEST_EXE}" new-published prove prove)
    run_phase("${TEST_EXE}" new-published corrupt corrupt-proof)
    foreach(replay direct coordinator)
        run_phase("${TEST_EXE}" new-pending-${replay} produce produce-pending)
        run_phase("${TEST_EXE}" new-pending-${replay} recover replay-${replay})
    endforeach()
    run_phase("${TEST_EXE}" live-pending accept live-pending)
    run_phase("${TEST_EXE}" live-pending recover recover-live)
    run_phase("${TEST_EXE}" live-worker publish live-worker)
    run_phase("${TEST_EXE}" live-worker prove prove)
    if(DEFINED OLD_TEST_EXE)
        run_phase("${OLD_TEST_EXE}" old-capacity refuse legacy-capacity)
        run_phase("${OLD_TEST_EXE}" old-published produce produce)
        run_phase("${TEST_EXE}" old-published prove prove)
        foreach(replay direct coordinator)
            run_phase("${OLD_TEST_EXE}" old-pending-${replay} produce produce-pending)
            run_phase("${TEST_EXE}" old-pending-${replay} recover replay-${replay})
        endforeach()
    endif()
endif()
file(WRITE "${root}/PASS.txt" "All requested phases passed.\n")
