if(NOT DEFINED TEST_EXE OR NOT EXISTS "${TEST_EXE}" OR NOT DEFINED EVIDENCE_ROOT)
    message(FATAL_ERROR "Native file test executable and evidence root are required")
endif()
if(NOT DEFINED TEST_TIMEOUT)
    set(TEST_TIMEOUT 240)
endif()
if(NOT TEST_TIMEOUT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Native file test timeout must be a positive integer")
endif()
string(TIMESTAMP run_time "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" run_id)
set(run_root "${EVIDENCE_ROOT}/run-${run_time}-${run_id}")
if(EXISTS "${run_root}")
    message(FATAL_ERROR "Refusing populated native file test evidence directory")
endif()
get_filename_component(run_parent "${run_root}" DIRECTORY)
file(MAKE_DIRECTORY "${run_parent}")
execute_process(COMMAND "${TEST_EXE}" "${run_root}" ${TEST_ARGUMENTS}
    RESULT_VARIABLE test_result OUTPUT_VARIABLE test_output ERROR_VARIABLE test_error TIMEOUT "${TEST_TIMEOUT}")
file(MAKE_DIRECTORY "${run_root}")
file(WRITE "${run_root}/stdout.log" "${test_output}")
file(WRITE "${run_root}/stderr.log" "${test_error}")
message("${test_output}${test_error}")
if(NOT test_result STREQUAL "0")
    message(FATAL_ERROR "Native file test failed: ${test_result}; evidence: ${run_root}")
endif()
