if(NOT DEFINED TEST_EXE OR NOT EXISTS "${TEST_EXE}" OR NOT DEFINED EVIDENCE_ROOT)
    message(FATAL_ERROR "Scale executable and private evidence root required")
endif()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" nonce)
set(root "${EVIDENCE_ROOT}/run-${stamp}-${nonce}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refusing populated scale evidence")
endif()
get_filename_component(parent "${root}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
foreach(phase init recover)
    execute_process(COMMAND "${TEST_EXE}" "${root}" "--${phase}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
    file(MAKE_DIRECTORY "${root}")
    file(WRITE "${root}/${phase}.log" "${output}${error}")
    message("${output}${error}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Sparse scale ${phase} failed: ${result}; ${root}")
    endif()
endforeach()
