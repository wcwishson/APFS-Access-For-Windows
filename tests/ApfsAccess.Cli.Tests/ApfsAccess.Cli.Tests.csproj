<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableStandardMount Condition="'$(EnableStandardMount)' == ''">true</EnableStandardMount>
    <DefineConstants Condition="'$(EnableStandardMount)' == 'true'">$(DefineConstants);APFSACCESS_STANDARD_MOUNT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\ApfsAccess.Backend.Native.Tests\RetainedOwnershipNativeReports.cs" Link="RetainedOwnershipNativeReports.cs" />
    <EmbeddedResource Include="..\ApfsAccess.Backend.Native.Tests\TestData\RetainedOwnership\*.json" LogicalName="RetainedOwnershipNativeReports.%(Filename)%(Extension)" />
    <Compile Include="..\ApfsAccess.Core.Tests\ExpectedPayloadTestData.cs" Link="ExpectedPayloadTestData.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ApfsAccess.Cli\ApfsAccess.Cli.csproj" />
    <ProjectReference Include="..\ApfsAccess.Cli.TestChild\ApfsAccess.Cli.TestChild.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyCliTestChildArtifacts" AfterTargets="Build">
    <ItemGroup>
      <_CliTestChildArtifacts Include="$(MSBuildProjectDirectory)\..\ApfsAccess.Cli.TestChild\bin\$(Configuration)\$(TargetFramework)\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_CliTestChildArtifacts)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Compile Include="..\ApfsAccess.Backend.Native.Tests\SnapshotAttributionTestData.cs" Link="SnapshotAttributionTestData.cs" />
  </ItemGroup>
</Project>
